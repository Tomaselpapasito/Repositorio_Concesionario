
@page
@model asp_front.Pages.Ventanas.EmpleadosModel

@{
    ViewData["Title"] = "Empleados";

    var totalEmpleados = Model.Lista?.Count ?? 0;
    var conCargo = Model.Lista?.Count(x => x.Cargo != 0) ?? 0;
    var conPersona = Model.Lista?.Count(x => x.Persona != 0) ?? 0;
}

<style>
    .empleados-container {
        padding: 25px;
        color: #263445;
    }

    .empleados-header {
        background: linear-gradient(135deg, #172536, #294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 25px;
    }

    .empleados-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .empleados-header p {
        color: #d4deea;
        margin: 0;
    }

    .empleados-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        height: 100%;
    }

    .empleados-card h2 {
        font-size: 30px;
        font-weight: 700;
        margin: 8px 0;
    }

    .empleados-card p {
        color: #758397;
        margin: 0;
    }

    .empleados-search,
    .empleados-form,
    .empleados-table-container {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        margin: 25px 0;
    }

    .empleados-search input,
    .empleados-form input,
    .empleados-form select {
        border: 1px solid #dce2e9;
        border-radius: 7px;
        padding: 10px;
        width: 100%;
        margin-bottom: 12px;
    }

    .empleados-form label {
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
    }

    .empleados-table-container {
        overflow-x: auto;
    }

    .empleados-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

    .empleados-table th {
        background: #f3f6fa;
        color: #526174;
        padding: 15px;
        text-align: left;
        font-size: 13px;
    }

    .empleados-table td {
        padding: 15px;
        border-bottom: 1px solid #edf0f4;
        vertical-align: middle;
    }

    .empleados-table tr:hover {
        background: #f8fafc;
    }

    .empleados-badge {
        background: #eaf1f8;
        color: #294766;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-empleados {
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        margin: 3px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

    .btn-azul:hover {
        background: #1c344d;
        color: white;
    }

    .btn-verde {
        background: #16834a;
        color: white;
    }

    .btn-verde:hover {
        background: #116638;
        color: white;
    }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

    .btn-rojo:hover {
        background: #fbdada;
        color: #a52a20;
    }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .empleados-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 15px;
    }

    .empleados-popup-inner {
        background: white;
        border-radius: 14px;
        padding: 30px;
        max-width: 450px;
        width: 100%;
        text-align: center;
    }
</style>

<form method="post">

    <div class="empleados-container">

        <div class="empleados-header">
            <h1>👨‍💼 Empleados</h1>
            <p>Administración del personal y sus cargos dentro del concesionario</p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="empleados-card">
                    <p>Total de empleados</p>
                    <h2>@totalEmpleados</h2>
                    <small>Empleados registrados</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="empleados-card">
                    <p>Con cargo asignado</p>
                    <h2 style="color:#16834a">@conCargo</h2>
                    <small>Empleados vinculados a un cargo</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="empleados-card">
                    <p>Con persona asociada</p>
                    <h2 style="color:#294766">@conPersona</h2>
                    <small>Empleados con datos personales</small>
                </div>
            </div>

        </div>

        <div class="empleados-search">

            <h5>Buscar empleados</h5>

            <div class="row mt-3">

                <div class="col-md-8">
                    <input placeholder="Buscar por número de carnet"
                           asp-for="@Model.Filtro!.Carnet" />
                </div>

                <div class="col-md-4">
                    <input type="submit"
                           value="Consultar"
                           class="btn-empleados btn-azul w-100"
                           asp-page-handler="BtConsultar" />
                </div>

            </div>

            <input type="submit"
                   value="+ Nuevo empleado"
                   class="btn-empleados btn-verde"
                   asp-page-handler="BtNuevo" />

        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.ID" />
        }

        @if (Model.Formulario)
        {
            <div class="empleados-form">

                <h4>Información del empleado</h4>
                <p class="text-muted">
                    Registra los datos laborales y selecciona la persona y el cargo correspondiente.
                </p>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <label>Número de carnet</label>
                        <input asp-for="@Model.Actual!.Carnet"
                               placeholder="Número de carnet" />
                    </div>

                    <div class="col-md-6">
                        <label>Fecha de contratación</label>
                        <input asp-for="@Model.Actual!.Fecha_Contratacion"
                               type="date" />
                    </div>

                    <div class="col-md-6">
                        <label>Persona</label>
                        <select asp-for="@Model.Actual!.Persona"
                                class="form-select">

                            <option value="0">Seleccionar persona</option>

                            @if (Model.PersonasLista != null)
                            {
                                foreach (var persona in Model.PersonasLista)
                                {
                                    <option value="@persona.ID">
                                        @persona.Nombre - @persona.Cedula
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-md-6">
                        <label>Cargo</label>
                        <select asp-for="@Model.Actual!.Cargo"
                                class="form-select">

                            <option value="0">Seleccionar cargo</option>

                            @if (Model.CargosLista != null)
                            {
                                foreach (var cargo in Model.CargosLista)
                                {
                                    <option value="@cargo.ID">
                                        @cargo.Nombre
                                    </option>
                                }
                            }

                        </select>
                    </div>

                </div>

                <div class="mt-3">

                    <input type="submit"
                           value="Guardar empleado"
                           class="btn-empleados btn-verde"
                           asp-page-handler="BtGuardar" />

                    <input type="submit"
                           value="Cancelar"
                           class="btn-empleados btn-gris"
                           asp-page-handler="BtConsultar" />

                </div>

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="empleados-popup">

                <div class="empleados-popup-inner">

                    <h3>⚠️ Confirmar eliminación</h3>

                    <p class="mt-3">
                        ¿Estás seguro de que deseas eliminar este empleado?
                    </p>

                    <p>
                        <strong>Carnet: @Model.Actual!.Carnet</strong>
                    </p>

                    <input type="submit"
                           value="Cancelar"
                           class="btn-empleados btn-gris"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Sí, eliminar"
                           class="btn-empleados btn-rojo"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="empleados-table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Listado de empleados</h4>
                    <span class="text-muted">@totalEmpleados registros</span>
                </div>

                <table class="empleados-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Carnet</th>
                            <th>Fecha de contratación</th>
                            <th>Persona</th>
                            <th>Cargo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista != null && Model.Lista.Count > 0)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td>@elemento.ID</td>
                                    <td><span class="empleados-badge">@elemento.Carnet</span></td>
                                    <td>
                                        @(elemento.Fecha_Contratacion == default
                                            ? "Sin fecha"
                                            : elemento.Fecha_Contratacion.ToString("dd/MM/yyyy"))
                                    </td>
                                    <td>@(elemento._Persona?.Nombre ?? "Sin persona")</td>
                                    <td>@(elemento._Cargo?.Nombre ?? "Sin cargo")</td>

                                    <td>
                                        <input type="submit"
                                               value="Editar"
                                               class="btn-empleados btn-azul"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.ID" />

                                        <input type="submit"
                                               value="Eliminar"
                                               class="btn-empleados btn-rojo"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.ID" />
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No hay empleados registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Index" class="btn-empleados btn-gris">
                Volver al inicio
            </a>
        </div>

    </div>

</form>
