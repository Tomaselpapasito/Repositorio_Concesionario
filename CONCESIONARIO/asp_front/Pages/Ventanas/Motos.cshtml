@page
@model asp_front.Pages.Modulos.MotosModel

@{
    ViewData["Title"] = "Motocicletas";

    var totalMotos = Model.Lista?.Count ?? 0;
    var disponibles = Model.Lista?.Count(x =>
        x.Estado == "Disponible") ?? 0;
}

<style>
    .motos-container {
        padding: 25px;
        color: #263445;
    }

    .motos-header {
        background: linear-gradient(135deg, #172536, #294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 25px;
        text-align: left;
    }

    .motos-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .motos-header p {
        color: #d4deea;
        margin: 0;
    }

    .motos-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        height: 100%;
    }

    .motos-card h2 {
        font-size: 30px;
        font-weight: 700;
        margin: 8px 0;
    }

    .motos-card p {
        color: #758397;
        margin: 0;
    }

    .motos-search {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        margin: 25px 0;
    }

    .motos-search input,
    .motos-form input {
        border: 1px solid #dce2e9;
        border-radius: 7px;
        padding: 10px;
        width: 100%;
        margin-bottom: 12px;
    }

    .motos-table-container {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        overflow-x: auto;
    }

    .motos-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

    .motos-table th {
        background: #f3f6fa;
        color: #526174;
        padding: 15px;
        text-align: left;
        font-size: 13px;
    }

    .motos-table td {
        padding: 15px;
        border-bottom: 1px solid #edf0f4;
        vertical-align: middle;
    }

    .motos-table tr:hover {
        background: #f8fafc;
    }

    .estado {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        background: #e2f7eb;
        color: #16834a;
    }

    .motos-form {
        background: white;
        padding: 25px;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        margin: 25px 0;
        text-align: left;
    }

    .motos-form label {
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
    }

    .btn-motos {
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        margin: 3px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

    .btn-azul:hover {
        background: #1c344d;
        color: white;
    }

    .btn-verde {
        background: #16834a;
        color: white;
    }

    .btn-verde:hover {
        background: #116638;
        color: white;
    }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

    .btn-rojo:hover {
        background: #fbdada;
        color: #a52a20;
    }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .motos-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 15px;
    }

    .motos-popup-inner {
        background: white;
        border-radius: 14px;
        padding: 30px;
        max-width: 450px;
        width: 100%;
        text-align: center;
    }
</style>

<form method="post">

    <div class="motos-container">

        <div class="motos-header">
            <h1>🏍️ Motocicletas</h1>
            <p>Administración del inventario del concesionario</p>
        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="motos-card">
                    <p>Total de motocicletas</p>
                    <h2>@totalMotos</h2>
                    <small>Registros en el inventario</small>
                </div>
            </div>

            <div class="col-md-6">
                <div class="motos-card">
                    <p>Motocicletas disponibles</p>
                    <h2 style="color:#16834a">@disponibles</h2>
                    <small>Unidades disponibles para venta</small>
                </div>
            </div>

        </div>

        <div class="motos-search">

            <h5>Buscar motocicletas</h5>

            <div class="row mt-3">

                <div class="col-md-5">
                    <input id="flVIN"
                           placeholder="Buscar por VIN"
                           asp-for="@Model.Filtro!.VIN" />
                </div>

                <div class="col-md-4">
                    <select id="flEstado"
                            asp-for="@Model.Filtro!.Estado"
                            class="form-select">

                        <option value="">Buscar por estado </option>
                        <option value="Disponible">Disponible</option>
                        <option value="Reservada">Reservada</option>
                        <option value="Vendida">Vendida</option>
                        <option value="En mantenimiento">En mantenimiento</option>

                    </select>
                </div>

                <div class="col-md-3">
                    <input type="submit"
                           value="Consultar"
                           class="btn-motos btn-azul w-100"
                           asp-page-handler="BtConsultar" />
                </div>

            </div>

            <input type="submit"
                   value="+ Nueva motocicleta"
                   class="btn-motos btn-verde"
                   asp-page-handler="BtNuevo" />

        </div>

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.ID" />
        }

        @if (Model.Formulario)
        {
            <div class="motos-form">

                <h4>Información de la motocicleta</h4>
                <p class="text-muted">
                    Completa los datos para registrar o actualizar una motocicleta.
                </p>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <label>VIN</label>
                        <input asp-for="@Model.Actual!.VIN"
                               placeholder="Número de identificación" />
                    </div>

                    <div class="col-md-6">
                        <label>Número de motor</label>
                        <input asp-for="@Model.Actual!.Numero_Motor"
                               placeholder="Número de motor" />
                    </div>

                    <div class="col-md-6">
                        <label>Color</label>
                        <input asp-for="@Model.Actual!.Color"
                               placeholder="Color de la motocicleta" />
                    </div>

                    <div class="col-md-6">
                        <label>Año</label>
                        <input type="number"
                               asp-for="@Model.Actual!.Anio"
                               placeholder="Año de fabricación" />
                    </div>

                    <div class="col-md-6">
                        <label>Modelo</label>
                        <select asp-for="@Model.Actual!.Modelo" class="form-select">
                            <option value="0">Seleccione un modelo</option>
                            @if (Model.ListaModelos != null)
                            {
                                foreach (var modelo in Model.ListaModelos)
                                {
                                    <option value="@modelo.ID">
                                        @modelo.Nombre
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label>Estado</label>
                        <select asp-for="@Model.Actual!.Estado" class="form-select">
                            <option value="">Seleccione un estado</option>
                            <option value="Disponible">Disponible</option>
                            <option value="Reservada">Reservada</option>
                            <option value="Vendida">Vendida</option>
                            <option value="En mantenimiento">En mantenimiento</option>
                        </select>
                    </div>

                </div>

                <div class="mt-3">

                    <input type="submit"
                           value="Guardar motocicleta"
                           class="btn-motos btn-verde"
                           asp-page-handler="BtGuardar" />

                    <input type="submit"
                           value="Cancelar"
                           class="btn-motos btn-gris"
                           asp-page-handler="BtConsultar" />

                </div>

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="motos-popup">

                <div class="motos-popup-inner">

                    <h3>⚠️ Confirmar eliminación</h3>

                    <p class="mt-3">
                        ¿Estás seguro de que deseas eliminar esta motocicleta?
                    </p>

                    <p>
                        <strong>@Model.Actual!.VIN</strong>
                        <br />
                        @Model.Actual.Numero_Motor
                        <br />
                        @Model.Actual.Color
                    </p>

                    <input type="submit"
                           value="Cancelar"
                           class="btn-motos btn-gris"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Sí, eliminar"
                           class="btn-motos btn-rojo"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="motos-table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Inventario de motocicletas</h4>
                    <span class="text-muted">@totalMotos registros</span>
                </div>

                <table class="motos-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>VIN</th>
                            <th>Número de motor</th>
                            <th>Color</th>
                            <th>Año</th>
                            <th>Modelo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista != null && Model.Lista.Count > 0)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td>@elemento.ID</td>
                                    <td>@elemento.VIN</td>
                                    <td>@elemento.Numero_Motor</td>
                                    <td>@elemento.Color</td>
                                    <td>@elemento.Anio</td>
                                    <td>@elemento._Modelo?.Nombre</td>

                                    <td>
                                        <span class="estado">
                                            @elemento.Estado
                                        </span>
                                    </td>

                                    <td>
                                        <input type="submit"
                                               value="Editar"
                                               class="btn-motos btn-azul"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.ID" />

                                        <input type="submit"
                                               value="Eliminar"
                                               class="btn-motos btn-rojo"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.ID" />
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">
                                    No hay motocicletas registradas.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Index" class="btn-motos btn-gris">
                Volver al inicio
            </a>
        </div>

    </div>

</form>
