
@page
@model asp_front.Pages.Modulos.ProductosModel

@{
    ViewData["Title"] = "Productos";

    var totalProductos = Model.Lista?.Count ?? 0;
    var productosActivos = Model.Lista?.Count(x => x.Activo) ?? 0;
    var stockTotal = Model.Lista?.Sum(x => x.Stock) ?? 0;
}

<style>
    .productos-container {
        padding: 25px;
        color: #263445;
    }

    .productos-header {
        background: linear-gradient(135deg, #172536, #294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 25px;
    }

    .productos-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .productos-header p {
        color: #d4deea;
        margin: 0;
    }

    .productos-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        height: 100%;
    }

    .productos-card h2 {
        font-size: 30px;
        font-weight: 700;
        margin: 8px 0;
    }

    .productos-card p {
        color: #758397;
        margin: 0;
    }

    .productos-search,
    .productos-form,
    .productos-table-container {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        margin: 25px 0;
    }

    .productos-search input,
    .productos-form input,
    .productos-form select {
        border: 1px solid #dce2e9;
        border-radius: 7px;
        padding: 10px;
        width: 100%;
        margin-bottom: 12px;
    }

    .productos-form label {
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
    }

    .productos-table-container {
        overflow-x: auto;
    }

    .productos-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1050px;
    }

    .productos-table th {
        background: #f3f6fa;
        color: #526174;
        padding: 15px;
        text-align: left;
        font-size: 13px;
    }

    .productos-table td {
        padding: 15px;
        border-bottom: 1px solid #edf0f4;
        vertical-align: middle;
    }

    .productos-table tr:hover {
        background: #f8fafc;
    }

    .estado-producto {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .activo {
        background: #e2f7eb;
        color: #16834a;
    }

    .inactivo {
        background: #fff0f0;
        color: #c0392b;
    }

    .productos-form {
        padding: 25px;
        text-align: left;
    }

    .btn-productos {
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        margin: 3px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

    .btn-azul:hover {
        background: #1c344d;
        color: white;
    }

    .btn-verde {
        background: #16834a;
        color: white;
    }

    .btn-verde:hover {
        background: #116638;
        color: white;
    }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

    .btn-rojo:hover {
        background: #fbdada;
        color: #a52a20;
    }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .productos-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 15px;
    }

    .productos-popup-inner {
        background: white;
        border-radius: 14px;
        padding: 30px;
        max-width: 450px;
        width: 100%;
        text-align: center;
    }
</style>

<form method="post">

    <div class="productos-container">

        <div class="productos-header">
            <h1>📦 Productos</h1>
            <p>Administración de productos y existencias del concesionario</p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="productos-card">
                    <p>Total de productos</p>
                    <h2>@totalProductos</h2>
                    <small>Productos registrados</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="productos-card">
                    <p>Productos activos</p>
                    <h2 style="color:#16834a">@productosActivos</h2>
                    <small>Productos habilitados</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="productos-card">
                    <p>Unidades en stock</p>
                    <h2 style="color:#294766">@stockTotal</h2>
                    <small>Existencias registradas</small>
                </div>
            </div>

        </div>

        <div class="productos-search">

            <h5>Buscar productos</h5>

            <div class="row mt-3">

                <div class="col-md-5">
                    <input placeholder="Buscar por código"
                           asp-for="@Model.Filtro!.Codigo" />
                </div>

                <div class="col-md-5">
                    <input placeholder="Buscar por nombre"
                           asp-for="@Model.Filtro!.Nombre" />
                </div>

                <div class="col-md-2">
                    <input type="submit"
                           value="Consultar"
                           class="btn-productos btn-azul w-100"
                           asp-page-handler="BtConsultar" />
                </div>

            </div>

            <input type="submit"
                   value="+ Nuevo producto"
                   class="btn-productos btn-verde"
                   asp-page-handler="BtNuevo" />

        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.ID" />
        }

        @if (Model.Formulario)
        {
            <div class="productos-form">

                <h4>Información del producto</h4>
                <p class="text-muted">
                    Completa los datos para registrar o actualizar un producto.
                </p>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <label>Código</label>
                        <input asp-for="@Model.Actual!.Codigo"
                               placeholder="Código del producto" />
                    </div>

                    <div class="col-md-6">
                        <label>Nombre</label>
                        <input asp-for="@Model.Actual!.Nombre"
                               placeholder="Nombre del producto" />
                    </div>

                    <div class="col-md-6">
                        <label>Fecha de creación</label>
                        <input type="date"
                               asp-for="@Model.Actual!.Fecha_Creacion" />
                    </div>

                    <div class="col-md-6">
                        <label>Fecha de modificación</label>
                        <input type="date"
                               asp-for="@Model.Actual!.Fecha_Modificacion" />
                    </div>

                    <div class="col-md-4">
                        <label>Precio</label>
                        <input type="number"
                               step="0.01"
                               min="0.01"
                               asp-for="@Model.Actual!.Precio"
                               placeholder="Precio del producto" />
                    </div>

                    <div class="col-md-4">
                        <label>Stock</label>
                        <input type="number"
                               min="0"
                               asp-for="@Model.Actual!.Stock"
                               placeholder="Cantidad disponible" />
                    </div>

                    <div class="col-md-4">
                        <label>Estado</label>
                        <select asp-for="@Model.Actual!.Activo"
                                class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                </div>

                <div class="mt-3">

                    <input type="submit"
                           value="Guardar producto"
                           class="btn-productos btn-verde"
                           asp-page-handler="BtGuardar" />

                    <input type="submit"
                           value="Cancelar"
                           class="btn-productos btn-gris"
                           asp-page-handler="BtConsultar" />

                </div>

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="productos-popup">

                <div class="productos-popup-inner">

                    <h3>⚠️ Confirmar eliminación</h3>

                    <p class="mt-3">
                        ¿Estás seguro de que deseas eliminar este producto?
                    </p>

                    <p>
                        <strong>@Model.Actual!.Nombre</strong>
                        <br />
                        Código: @Model.Actual.Codigo
                        <br />
                        Stock: @Model.Actual.Stock
                    </p>

                    <input type="submit"
                           value="Cancelar"
                           class="btn-productos btn-gris"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Sí, eliminar"
                           class="btn-productos btn-rojo"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="productos-table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Inventario de productos</h4>
                    <span class="text-muted">@totalProductos registros</span>
                </div>

                <table class="productos-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Fecha de creación</th>
                            <th>Última modificación</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista != null && Model.Lista.Count > 0)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td>@elemento.ID</td>
                                    <td>@elemento.Codigo</td>
                                    <td><strong>@elemento.Nombre</strong></td>
                                    <td>@elemento.Fecha_Creacion.ToString("dd/MM/yyyy")</td>
                                    <td>@elemento.Fecha_Modificacion.ToString("dd/MM/yyyy")</td>
                                    <td>@elemento.Precio.ToString("C")</td>
                                    <td>@elemento.Stock</td>

                                    <td>
                                        @if (elemento.Activo)
                                        {
                                            <span class="estado-producto activo">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="estado-producto inactivo">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <input type="submit"
                                               value="Editar"
                                               class="btn-productos btn-azul"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.ID" />

                                        <input type="submit"
                                               value="Eliminar"
                                               class="btn-productos btn-rojo"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.ID" />
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">
                                    No hay productos registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Index" class="btn-productos btn-gris">
                Volver al inicio
            </a>
        </div>

    </div>

</form>
