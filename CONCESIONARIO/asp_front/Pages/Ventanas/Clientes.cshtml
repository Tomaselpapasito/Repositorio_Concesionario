@page
@model asp_front.Pages.Ventanas.ClientesModel

@{
    ViewData["Title"] = "Clientes";

    var totalClientes = Model.Lista?.Count ?? 0;
    var clientesActivos = Model.Lista?.Count(x => x.Activo) ?? 0;
}

<style>
    .clientes-container {
        padding: 25px;
        color: #263445;
    }

    .clientes-header {
        background: linear-gradient(135deg, #172536, #294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 25px;
        text-align: left;
    }

        .clientes-header h1 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .clientes-header p {
            color: #d4deea;
            margin: 0;
        }

    .clientes-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        height: 100%;
    }

        .clientes-card h2 {
            font-size: 30px;
            font-weight: 700;
            margin: 8px 0;
        }

        .clientes-card p {
            color: #758397;
            margin: 0;
        }

    .clientes-search {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        margin: 25px 0;
    }

        .clientes-search input,
        .clientes-form input,
        .clientes-form select {
            border: 1px solid #dce2e9;
            border-radius: 7px;
            padding: 10px;
            width: 100%;
            margin-bottom: 12px;
        }

    .clientes-table-container {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        overflow-x: auto;
    }

    .clientes-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 750px;
    }

        .clientes-table th {
            background: #f3f6fa;
            color: #526174;
            padding: 15px;
            text-align: left;
            font-size: 13px;
        }

        .clientes-table td {
            padding: 15px;
            border-bottom: 1px solid #edf0f4;
            vertical-align: middle;
        }

        .clientes-table tr:hover {
            background: #f8fafc;
        }

    .estado-cliente {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        background: #e2f7eb;
        color: #16834a;
    }

    .estado-inactivo {
        background: #fff0f0;
        color: #c0392b;
    }

    .clientes-form {
        background: white;
        padding: 25px;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        margin: 25px 0;
        text-align: left;
    }

        .clientes-form label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
        }

        .clientes-form input[type="checkbox"] {
            width: auto;
        }

    .btn-clientes {
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        margin: 3px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

        .btn-azul:hover {
            background: #1c344d;
            color: white;
        }

    .btn-verde {
        background: #16834a;
        color: white;
    }

        .btn-verde:hover {
            background: #116638;
            color: white;
        }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

        .btn-rojo:hover {
            background: #fbdada;
            color: #a52a20;
        }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .clientes-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 15px;
    }

    .clientes-popup-inner {
        background: white;
        border-radius: 14px;
        padding: 30px;
        max-width: 450px;
        width: 100%;
        text-align: center;
    }
</style>

<form method="post">

    <div class="clientes-container">

        <div class="clientes-header">
            <h1>👥 Clientes</h1>
            <p>Administración de clientes del concesionario</p>
        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="clientes-card">
                    <p>Total de clientes</p>
                    <h2>@totalClientes</h2>
                    <small>Registros de clientes</small>
                </div>
            </div>

            <div class="col-md-6">
                <div class="clientes-card">
                    <p>Clientes activos</p>
                    <h2 style="color:#16834a">@clientesActivos</h2>
                    <small>Clientes habilitados</small>
                </div>
            </div>

        </div>

        <div class="clientes-search">

            <h5>Buscar clientes</h5>

            <div class="row mt-3">

                <div class="col-md-8">
                    <input id="flLicencia"
                           placeholder="Buscar por número de licencia"
                           asp-for="@Model.Filtro!.Numero_Licencia" />
                </div>

                <div class="col-md-4">
                    <input type="submit"
                           value="Consultar"
                           class="btn-clientes btn-azul w-100"
                           asp-page-handler="BtConsultar" />
                </div>

            </div>

            <input type="submit"
                   value="+ Nuevo cliente"
                   class="btn-clientes btn-verde"
                   asp-page-handler="BtNuevo" />

        </div>

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.ID" />
        }

        @if (Model.Formulario)
        {
            <div class="clientes-form">

                <h4>Información del cliente</h4>

                <p class="text-muted">
                    Completa los datos para registrar o actualizar un cliente.
                </p>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <label>Correo electrónico</label>
                        <input asp-for="@Model.Actual!.Correo"
                               placeholder="Correo electrónico" />
                    </div>

                    <div class="col-md-6">
                        <label>Número de licencia</label>
                        <input asp-for="@Model.Actual!.Numero_Licencia"
                               placeholder="Número de licencia" />
                    </div>

                    <div class="col-md-12">
                        <label>Dirección</label>
                        <input asp-for="@Model.Actual!.Direccion"
                               placeholder="Dirección del cliente" />
                    </div>

                    <div class="col-md-6">
                        <label>Persona relacionada</label>
                        <select asp-for="@Model.Actual!.Persona"
                                class="form-select">
                            <option value="">Seleccione una persona</option>
                            @foreach (var persona in Model.ListaPersonas)
                            {
                                <option value="@persona.ID">
                                    @persona.Nombre - @persona.Cedula
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label>Estado del cliente</label>
                        <select asp-for="@Model.Actual!.Activo"
                                class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                </div>

                <div class="mt-3">

                    <input type="submit"
                           value="Guardar cliente"
                           class="btn-clientes btn-verde"
                           asp-page-handler="BtGuardar" />

                    <input type="submit"
                           value="Cancelar"
                           class="btn-clientes btn-gris"
                           asp-page-handler="BtConsultar" />

                </div>

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="clientes-popup">

                <div class="clientes-popup-inner">

                    <h3>⚠️ Confirmar eliminación</h3>

                    <p class="mt-3">
                        ¿Estás seguro de que deseas eliminar este cliente?
                    </p>

                    <p>
                        <strong>@Model.Actual!.Correo</strong>
                        <br />
                        @Model.Actual.Numero_Licencia
                        <br />
                        @Model.Actual.Direccion
                    </p>

                    <input type="submit"
                           value="Cancelar"
                           class="btn-clientes btn-gris"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Sí, eliminar"
                           class="btn-clientes btn-rojo"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="clientes-table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Listado de clientes</h4>
                    <span class="text-muted">@totalClientes registros</span>
                </div>

                <table class="clientes-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Correo</th>
                            <th>Número de licencia</th>
                            <th>Dirección</th>
                            <th>Activo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista != null && Model.Lista.Count > 0)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td>@elemento.ID</td>
                                    <td>@elemento.Correo</td>
                                    <td>@elemento.Numero_Licencia</td>
                                    <td>@elemento.Direccion</td>

                                    <td>
                                        @if (elemento.Activo)
                                        {
                                            <span class="estado-cliente">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="estado-cliente estado-inactivo">Inactivo</span>
                                        }
                                    </td>

                                    <td>
                                        <input type="submit"
                                               value="Editar"
                                               class="btn-clientes btn-azul"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.ID" />

                                        <input type="submit"
                                               value="Eliminar"
                                               class="btn-clientes btn-rojo"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.ID" />
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No hay clientes registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Index" class="btn-clientes btn-gris">
                Volver al inicio
            </a>
        </div>

    </div>

</form>
