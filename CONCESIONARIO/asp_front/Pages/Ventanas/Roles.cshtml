@page
@model asp_front.Pages.Ventanas.RolesModel

@{
    ViewData["Title"] = "Roles";

    var totalRoles = Model.Lista?.Count ?? 0;
}

<style>
    .roles-container {
        padding: 25px;
        color: #263445;
    }

    .roles-header {
        background: linear-gradient(135deg, #172536, #294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 25px;
        text-align: left;
    }

        .roles-header h1 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .roles-header p {
            color: #d4deea;
            margin: 0;
        }

    .roles-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        height: 100%;
    }

        .roles-card h2 {
            font-size: 30px;
            font-weight: 700;
            margin: 8px 0;
        }

        .roles-card p {
            color: #758397;
            margin: 0;
        }

    .roles-search {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        margin: 25px 0;
    }

        .roles-search input,
        .roles-form input {
            border: 1px solid #dce2e9;
            border-radius: 7px;
            padding: 10px;
            width: 100%;
            margin-bottom: 12px;
        }

    .roles-table-container {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        overflow-x: auto;
    }

    .roles-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }

        .roles-table th {
            background: #f3f6fa;
            color: #526174;
            padding: 15px;
            text-align: left;
            font-size: 13px;
        }

        .roles-table td {
            padding: 15px;
            border-bottom: 1px solid #edf0f4;
            vertical-align: middle;
        }

        .roles-table tr:hover {
            background: #f8fafc;
        }

    .roles-form {
        background: white;
        padding: 25px;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        margin: 25px 0;
        text-align: left;
    }

        .roles-form label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
        }

    .btn-roles {
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        margin: 3px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

        .btn-azul:hover {
            background: #1c344d;
            color: white;
        }

    .btn-verde {
        background: #16834a;
        color: white;
    }

        .btn-verde:hover {
            background: #116638;
            color: white;
        }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

        .btn-rojo:hover {
            background: #fbdada;
            color: #a52a20;
        }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .roles-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 15px;
    }

    .roles-popup-inner {
        background: white;
        border-radius: 14px;
        padding: 30px;
        max-width: 450px;
        width: 100%;
        text-align: center;
    }
</style>

<form method="post">

    <div class="roles-container">

        <div class="roles-header">
            <h1>👥 Roles</h1>
            <p>Administración de roles del concesionario</p>
        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="roles-card">
                    <p>Total de roles</p>
                    <h2>@totalRoles</h2>
                    <small>Registros de roles</small>
                </div>
            </div>

            <div class="col-md-6">
                <div class="roles-card">
                    <p>Gestión de usuarios</p>
                    <h2 style="color:#16834a">Usuarios</h2>
                    <small>Asignación de roles</small>
                </div>
            </div>

        </div>

        <div class="roles-search">

            <h5>Buscar roles</h5>

            <div class="row mt-3">

                <div class="col-md-8">
                    <input placeholder="Buscar por nombre del rol"
                           asp-for="@Model.Filtro!.Nombre" />
                </div>

                <div class="col-md-4">
                    <input type="submit"
                           value="Consultar"
                           class="btn-roles btn-azul w-100"
                           asp-page-handler="BtConsultar" />
                </div>

            </div>

            <input type="submit"
                   value="+ Nuevo rol"
                   class="btn-roles btn-verde"
                   asp-page-handler="BtNuevo" />

        </div>

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.ID" />
        }

        @if (Model.Formulario)
        {
            <div class="roles-form">

                <h4>Información del rol</h4>

                <p class="text-muted">
                    Completa los datos para registrar o actualizar un rol.
                </p>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <label>Nombre del rol</label>
                        <input asp-for="@Model.Actual!.Nombre"
                               placeholder="Nombre del rol" />
                    </div>

                    <div class="col-md-6">
                        <label>ID del usuario</label>
                        <input type="number"
                               asp-for="@Model.Actual!.Usuario"
                               placeholder="Identificador del usuario" />
                    </div>

                </div>

                <div class="mt-3">

                    <input type="submit"
                           value="Guardar rol"
                           class="btn-roles btn-verde"
                           asp-page-handler="BtGuardar" />

                    <input type="submit"
                           value="Cancelar"
                           class="btn-roles btn-gris"
                           asp-page-handler="BtConsultar" />

                </div>

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="roles-popup">

                <div class="roles-popup-inner">

                    <h3>⚠️ Confirmar eliminación</h3>

                    <p class="mt-3">
                        ¿Estás seguro de que deseas eliminar este rol?
                    </p>

                    <p>
                        <strong>@Model.Actual!.Nombre</strong>
                        <br />
                        Usuario: @Model.Actual.Usuario
                    </p>

                    <input type="submit"
                           value="Cancelar"
                           class="btn-roles btn-gris"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Sí, eliminar"
                           class="btn-roles btn-rojo"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="roles-table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Listado de roles</h4>
                    <span class="text-muted">@totalRoles registros</span>
                </div>

                <table class="roles-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista != null && Model.Lista.Count > 0)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td>@elemento.ID</td>
                                    <td>@elemento.Nombre</td>
                                    <td>@elemento.Usuario</td>

                                    <td>
                                        <input type="submit"
                                               value="Editar"
                                               class="btn-roles btn-azul"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.ID" />

                                        <input type="submit"
                                               value="Eliminar"
                                               class="btn-roles btn-rojo"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.ID" />
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">
                                    No hay roles registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Index" class="btn-roles btn-gris">
                Volver al inicio
            </a>
        </div>

    </div>

</form>
