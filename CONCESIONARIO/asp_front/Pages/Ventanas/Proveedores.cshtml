
@page
@model asp_front.Pages.Ventanas.ProveedoresModel

@{
    ViewData["Title"] = "Proveedores";

    var totalProveedores = Model.Lista?.Count ?? 0;
    var correos = Model.Lista?.Count(x => !string.IsNullOrEmpty(x.Correo)) ?? 0;
    var telefonos = Model.Lista?.Count(x => !string.IsNullOrEmpty(x.Telefono)) ?? 0;
}

<style>
    .proveedores-container {
        padding: 25px;
        color: #263445;
    }

    .proveedores-header {
        background: linear-gradient(135deg, #172536, #294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 25px;
    }

    .proveedores-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .proveedores-header p {
        color: #d4deea;
        margin: 0;
    }

    .proveedores-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        height: 100%;
    }

    .proveedores-card h2 {
        font-size: 30px;
        font-weight: 700;
        margin: 8px 0;
    }

    .proveedores-card p {
        color: #758397;
        margin: 0;
    }

    .proveedores-search,
    .proveedores-form,
    .proveedores-table-container {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        margin: 25px 0;
    }

    .proveedores-search input,
    .proveedores-form input {
        border: 1px solid #dce2e9;
        border-radius: 7px;
        padding: 10px;
        width: 100%;
        margin-bottom: 12px;
    }

    .proveedores-form label {
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
    }

    .proveedores-table-container {
        overflow-x: auto;
    }

    .proveedores-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    .proveedores-table th {
        background: #f3f6fa;
        color: #526174;
        padding: 15px;
        text-align: left;
        font-size: 13px;
    }

    .proveedores-table td {
        padding: 15px;
        border-bottom: 1px solid #edf0f4;
        vertical-align: middle;
    }

    .proveedores-table tr:hover {
        background: #f8fafc;
    }

    .btn-proveedores {
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        margin: 3px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

    .btn-azul:hover {
        background: #1c344d;
        color: white;
    }

    .btn-verde {
        background: #16834a;
        color: white;
    }

    .btn-verde:hover {
        background: #116638;
        color: white;
    }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

    .btn-rojo:hover {
        background: #fbdada;
        color: #a52a20;
    }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .proveedores-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 15px;
    }

    .proveedores-popup-inner {
        background: white;
        border-radius: 14px;
        padding: 30px;
        max-width: 450px;
        width: 100%;
        text-align: center;
    }
</style>

<form method="post">

    <div class="proveedores-container">

        <div class="proveedores-header">
            <h1>🏢 Proveedores</h1>
            <p>Administración de proveedores y sus datos de contacto</p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="proveedores-card">
                    <p>Total de proveedores</p>
                    <h2>@totalProveedores</h2>
                    <small>Proveedores registrados</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="proveedores-card">
                    <p>Con correo registrado</p>
                    <h2 style="color:#16834a">@correos</h2>
                    <small>Contactos por correo</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="proveedores-card">
                    <p>Con teléfono registrado</p>
                    <h2 style="color:#294766">@telefonos</h2>
                    <small>Contactos telefónicos</small>
                </div>
            </div>

        </div>

        <div class="proveedores-search">

            <h5>Buscar proveedores</h5>

            <div class="row mt-3">

                <div class="col-md-4">
                    <input placeholder="Buscar por nombre"
                           asp-for="@Model.Filtro!.Nombre" />
                </div>

                <div class="col-md-4">
                    <input placeholder="Buscar por NIT"
                           asp-for="@Model.Filtro!.NIT" />
                </div>

                <div class="col-md-4">
                    <input type="submit"
                           value="Consultar"
                           class="btn-proveedores btn-azul w-100"
                           asp-page-handler="BtConsultar" />
                </div>

            </div>

            <input type="submit"
                   value="+ Nuevo proveedor"
                   class="btn-proveedores btn-verde"
                   asp-page-handler="BtNuevo" />

        </div>


        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.ID" />
        }

        @if (Model.Formulario)
        {
            <div class="proveedores-form">

                <h4>Información del proveedor</h4>
                <p class="text-muted">
                    Completa los datos para registrar o actualizar un proveedor.
                </p>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <label>Nombre</label>
                        <input asp-for="@Model.Actual!.Nombre"
                               placeholder="Nombre del proveedor" />
                    </div>

                    <div class="col-md-6">
                        <label>NIT</label>
                        <input asp-for="@Model.Actual!.NIT"
                               placeholder="Número de identificación tributaria" />
                    </div>

                    <div class="col-md-6">
                        <label>Teléfono</label>
                        <input asp-for="@Model.Actual!.Telefono"
                               placeholder="Número de contacto" />
                    </div>

                    <div class="col-md-6">
                        <label>Correo electrónico</label>
                        <input asp-for="@Model.Actual!.Correo"
                               type="email"
                               placeholder="Correo del proveedor" />
                    </div>

                    <div class="col-md-12">
                        <label>Dirección</label>
                        <input asp-for="@Model.Actual!.Direccion"
                               placeholder="Dirección del proveedor" />
                    </div>

                </div>

                <div class="mt-3">

                    <input type="submit"
                           value="Guardar proveedor"
                           class="btn-proveedores btn-verde"
                           asp-page-handler="BtGuardar" />

                    <input type="submit"
                           value="Cancelar"
                           class="btn-proveedores btn-gris"
                           asp-page-handler="BtConsultar" />

                </div>

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="proveedores-popup">

                <div class="proveedores-popup-inner">

                    <h3>⚠️ Confirmar eliminación</h3>

                    <p class="mt-3">
                        ¿Estás seguro de que deseas eliminar este proveedor?
                    </p>

                    <p>
                        <strong>@Model.Actual!.Nombre</strong>
                        <br />
                        NIT: @Model.Actual.NIT
                    </p>

                    <input type="submit"
                           value="Cancelar"
                           class="btn-proveedores btn-gris"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Sí, eliminar"
                           class="btn-proveedores btn-rojo"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="proveedores-table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Listado de proveedores</h4>
                    <span class="text-muted">@totalProveedores registros</span>
                </div>

                <table class="proveedores-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>NIT</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Dirección</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista != null && Model.Lista.Count > 0)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td>@elemento.ID</td>
                                    <td><strong>@elemento.Nombre</strong></td>
                                    <td>@elemento.NIT</td>
                                    <td>@elemento.Telefono</td>
                                    <td>@elemento.Correo</td>
                                    <td>@elemento.Direccion</td>

                                    <td>
                                        <input type="submit"
                                               value="Editar"
                                               class="btn-proveedores btn-azul"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.ID" />

                                        <input type="submit"
                                               value="Eliminar"
                                               class="btn-proveedores btn-rojo"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.ID" />
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">
                                    No hay proveedores registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Index" class="btn-proveedores btn-gris">
                Volver al inicio
            </a>
        </div>

    </div>

</form>
