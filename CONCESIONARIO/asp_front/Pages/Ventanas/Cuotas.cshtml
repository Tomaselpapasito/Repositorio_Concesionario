@page
@model asp_front.Pages.Ventanas.CuotasModel

@{
    ViewData["Title"] = "Cuotas";
    var total = Model.Lista?.Count ?? 0;
}

<style>
    .cuotas-container {
        padding: 25px;
        color: #263445;
    }

    .cuotas-header {
        background: linear-gradient(135deg,#172536,#294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 22px;
    }

    .cuotas-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 3px 12px #00000012;
        height: 100%;
    }

    .cuotas-search, .cuotas-form {
        background: white;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 3px 12px #00000012;
        margin-bottom: 22px;
    }

    .cuotas-table-container {
        background: white;
        padding: 18px;
        border-radius: 12px;
        overflow-x: auto;
        box-shadow: 0 3px 12px #00000012;
    }

    .cuotas-table {
        width: 100%;
        border-collapse: collapse;
    }

        .cuotas-table th {
            background: #f3f6fa;
            padding: 13px;
            text-align: left;
        }

        .cuotas-table td {
            padding: 12px;
            border-bottom: 1px solid #e5e9ef;
        }

    .cuotas-form label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .cuotas-form input {
        width: 100%;
        padding: 10px;
        border: 1px solid #ced6df;
        border-radius: 7px;
    }

    .btn-cuotas {
        border: 0;
        border-radius: 7px;
        padding: 9px 15px;
        color: white;
        cursor: pointer;
        margin: 2px;
    }
    .btn-azul {
    background: #294766;
    color: white;
    }

    .btn-azul:hover {
        background: #1c344d;
        color: white;
    }

    .btn-verde {
        background: #16834a;
        color: white;
    }

    .btn-verde:hover {
        background: #116638;
        color: white;
    }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

    .btn-rojo:hover {
        background: #fbdada;
        color: #a52a20;
    }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }
    .cuotas-popup {
        background: #fff4f4;
        border: 1px solid #f2baba;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
    }
</style>

<form method="post">
    <div class="cuotas-container">

        <div class="cuotas-header">
            <h1>📅 Cuotas</h1>
            <p>Administración y seguimiento de las cuotas de financiación</p>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="cuotas-card">
                    <p>Total de cuotas registradas</p>
                    <h2>@total</h2>
                </div>
            </div>
            <div class="col-md-6">
                <div class="cuotas-card">
                    <p>Gestión de pagos</p>
                    <h2 style="color:#16834a">Cuotas</h2>
                </div>
            </div>
        </div>

        <div class="cuotas-search">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">ID del financiamiento</label>
                    <input asp-for="Filtro!.Financiamiento" type="number" class="form-control" placeholder="Buscar por financiamiento..." />
                </div>
                <div class="col-md-2">
                    <input type="submit" value="Consultar" asp-page-handler="BtConsultar" class="btn-cuotas btn-azul w-100" />
                </div>
                <div class="col-md-2">
                    <input type="submit" value="+ Nueva cuota" asp-page-handler="BtNuevo" class="btn-cuotas btn-verde w-100" />
                </div>
            </div>
        </div>

        @if (Model.Formulario && Model.Actual != null)
        {
            <div class="cuotas-form">
                <h3>@(Model.Actual.ID == 0 ? "Nueva cuota" : "Editar cuota")</h3>

                <input type="hidden" asp-for="Actual!.ID" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label>Número de cuota</label>
                        <input asp-for="Actual!.Numero_cuota" type="number" />
                    </div>

                    <div class="col-md-6">
                        <label>Monto</label>
                        <input asp-for="Actual!.Monto" type="number" step="0.01" />
                    </div>

                    <div class="col-md-6">
                        <label>Fecha de vencimiento</label>
                        <input asp-for="Actual!.Fecha_vencimiento" type="date" />
                    </div>

                    <div class="col-md-6">
                        <label>Fecha de pago</label>
                        <input asp-for="Actual!.Fecha_pago" type="date" />
                    </div>

                    <div class="col-md-6">
                        <label>ID del financiamiento</label>
                        <input asp-for="Actual!.Financiamiento" type="number" />
                    </div>
                </div>

                <div class="mt-4">
                    <input type="submit" value="Guardar" asp-page-handler="BtGuardar" class="btn-cuotas btn-verde" />
                    <input type="submit" value="Cancelar" asp-page-handler="BtConsultar" class="btn-cuotas btn-gris" />
                </div>
            </div>
        }

        @if (Model.Borrar && Model.Actual != null)
        {
            <div class="cuotas-popup">
                <h4>¿Deseas eliminar esta cuota?</h4>
                <p>Cuota: <strong>@Model.Actual.Numero_cuota</strong></p>

                <input type="hidden" asp-for="Actual!.ID" />

                <input type="submit" value="Sí, eliminar" asp-page-handler="BtBorrar" class="btn-cuotas btn-rojo" />
                <input type="submit" value="Cancelar" asp-page-handler="BtConsultar" class="btn-cuotas btn-gris" />
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="cuotas-table-container">
                <h3>Listado de cuotas</h3>

                <table class="cuotas-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Número</th>
                            <th>Monto</th>
                            <th>Vencimiento</th>
                            <th>Fecha de pago</th>
                            <th>Financiamiento</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Lista)
                        {
                            <tr>
                                <td>@item.ID</td>
                                <td>@item.Numero_cuota</td>
                                <td>@item.Monto</td>
                                <td>@item.Fecha_vencimiento.ToString("dd/MM/yyyy")</td>
                                <td>@(item.Fecha_pago?.ToString("dd/MM/yyyy") ?? "Pendiente")</td>
                                <td>@item.Financiamiento</td>
                                <td>
                                    <input type="submit" value="Editar" asp-page-handler="BtEditar" asp-route-data="@item.ID" class="btn-cuotas btn-azul" />
                                    <input type="submit" value="Eliminar" asp-page-handler="BtPregBorrar" asp-route-data="@item.ID" class="btn-cuotas btn-rojo" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-4">
            <a asp-page="/Index" class="btn-cuotas btn-gris">Volver al inicio</a>
        </div>

    </div>
</form>
