
@page
@model asp_front.Pages.Modulos.AccesoriosModel

@{
    ViewData["Title"] = "Accesorios";

    var totalAccesorios = Model.Lista?.Count ?? 0;
    var categorias = Model.Lista?
        .Select(x => x.Categoria).Distinct().Count() ?? 0;
    var marcas = Model.Lista?
        .Select(x => x.Marca).Distinct().Count() ?? 0;
}

<style>
    .accesorios-container {
        padding: 25px;
        color: #263445;
    }

    .accesorios-header {
        background: linear-gradient(135deg, #172536, #294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 25px;
    }

    .accesorios-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .accesorios-header p {
        color: #d4deea;
        margin: 0;
    }

    .accesorios-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        height: 100%;
    }

    .accesorios-card h2 {
        font-size: 30px;
        font-weight: 700;
        margin: 8px 0;
    }

    .accesorios-card p {
        color: #758397;
        margin: 0;
    }

    .accesorios-search,
    .accesorios-form,
    .accesorios-table-container {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        margin: 25px 0;
    }

    .accesorios-search input,
    .accesorios-form input,
    .accesorios-form select {
        border: 1px solid #dce2e9;
        border-radius: 7px;
        padding: 10px;
        width: 100%;
        margin-bottom: 12px;
    }

    .accesorios-form label {
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
    }

    .accesorios-table-container {
        overflow-x: auto;
    }

    .accesorios-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

    .accesorios-table th {
        background: #f3f6fa;
        color: #526174;
        padding: 15px;
        text-align: left;
        font-size: 13px;
    }

    .accesorios-table td {
        padding: 15px;
        border-bottom: 1px solid #edf0f4;
        vertical-align: middle;
    }

    .accesorios-table tr:hover {
        background: #f8fafc;
    }

    .accesorios-form {
        padding: 25px;
        text-align: left;
    }

    .btn-accesorios {
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        margin: 3px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

    .btn-azul:hover {
        background: #1c344d;
        color: white;
    }

    .btn-verde {
        background: #16834a;
        color: white;
    }

    .btn-verde:hover {
        background: #116638;
        color: white;
    }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

    .btn-rojo:hover {
        background: #fbdada;
        color: #a52a20;
    }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .accesorios-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 15px;
    }

    .accesorios-popup-inner {
        background: white;
        border-radius: 14px;
        padding: 30px;
        max-width: 450px;
        width: 100%;
        text-align: center;
    }
</style>

<form method="post">

    <div class="accesorios-container">

        <div class="accesorios-header">
            <h1>🛠️ Accesorios</h1>
            <p>Administración de accesorios y complementos del concesionario</p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="accesorios-card">
                    <p>Total de accesorios</p>
                    <h2>@totalAccesorios</h2>
                    <small>Accesorios registrados</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="accesorios-card">
                    <p>Categorías</p>
                    <h2 style="color:#16834a">@categorias</h2>
                    <small>Categorías diferentes</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="accesorios-card">
                    <p>Marcas</p>
                    <h2 style="color:#294766">@marcas</h2>
                    <small>Marcas registradas</small>
                </div>
            </div>

        </div>

        <div class="accesorios-search">

            <h5>Buscar accesorios</h5>

            <div class="row mt-3">

                <div class="col-md-3">
                    <input placeholder="Buscar por nombre"
                           asp-for="@Model.Filtro!.Nombre" />
                </div>

                <div class="col-md-3">
                    <input placeholder="Buscar por categoría"
                           asp-for="@Model.Filtro!.Categoria" />
                </div>

                <div class="col-md-3">
                    <input placeholder="Buscar por marca"
                           asp-for="@Model.Filtro!.Marca" />
                </div>

                <div class="col-md-3">
                    <input type="submit"
                           value="Consultar"
                           class="btn-accesorios btn-azul w-100"
                           asp-page-handler="BtConsultar" />
                </div>

            </div>

            <input type="submit"
                   value="+ Nuevo accesorio"
                   class="btn-accesorios btn-verde"
                   asp-page-handler="BtNuevo" />

        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.ID" />
        }

        @if (Model.Formulario)
        {
            <div class="accesorios-form">

                <h4>Información del accesorio</h4>
                <p class="text-muted">
                    Completa los datos para registrar o actualizar un accesorio.
                </p>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <label>Nombre</label>
                        <input asp-for="@Model.Actual!.Nombre"
                               placeholder="Nombre del accesorio" />
                    </div>

                    <div class="col-md-6">
                        <label>Categoría</label>
                        <input asp-for="@Model.Actual!.Categoria"
                               placeholder="Categoría del accesorio" />
                    </div>

                    <div class="col-md-6">
                        <label>Marca</label>
                        <input asp-for="@Model.Actual!.Marca"
                               placeholder="Marca del accesorio" />
                    </div>

                    <div class="col-md-6">
                        <label>Producto relacionado</label>
                        <select asp-for="@Model.Actual!.Producto"
                                class="form-select">
                            <option value="">Seleccione un producto</option>

                            @if (Model.ListaProductos != null)
                            {
                                foreach (var producto in Model.ListaProductos)
                                {
                                    <option value="@producto.ID">
                                        @producto.Nombre - @producto.Codigo
                                    </option>
                                }
                            }
                        </select>
                    </div>

                </div>

                <div class="mt-3">

                    <input type="submit"
                           value="Guardar accesorio"
                           class="btn-accesorios btn-verde"
                           asp-page-handler="BtGuardar" />

                    <input type="submit"
                           value="Cancelar"
                           class="btn-accesorios btn-gris"
                           asp-page-handler="BtConsultar" />

                </div>

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="accesorios-popup">

                <div class="accesorios-popup-inner">

                    <h3>⚠️ Confirmar eliminación</h3>

                    <p class="mt-3">
                        ¿Estás seguro de que deseas eliminar este accesorio?
                    </p>

                    <p>
                        <strong>@Model.Actual!.Nombre</strong>
                        <br />
                        Categoría: @Model.Actual.Categoria
                        <br />
                        Marca: @Model.Actual.Marca
                    </p>

                    <input type="submit"
                           value="Cancelar"
                           class="btn-accesorios btn-gris"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Sí, eliminar"
                           class="btn-accesorios btn-rojo"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="accesorios-table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Inventario de accesorios</h4>
                    <span class="text-muted">@totalAccesorios registros</span>
                </div>

                <table class="accesorios-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Marca</th>
                            <th>Producto relacionado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista != null && Model.Lista.Count > 0)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td>@elemento.ID</td>
                                    <td><strong>@elemento.Nombre</strong></td>
                                    <td>@elemento.Categoria</td>
                                    <td>@elemento.Marca</td>
                                    <td>
                                        @(Model.ListaProductos?
                                            .FirstOrDefault(x => x.ID == elemento.Producto)?.Nombre
                                            ?? "Sin producto")
                                    </td>

                                    <td>
                                        <input type="submit"
                                               value="Editar"
                                               class="btn-accesorios btn-azul"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.ID" />

                                        <input type="submit"
                                               value="Eliminar"
                                               class="btn-accesorios btn-rojo"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.ID" />
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No hay accesorios registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Index" class="btn-accesorios btn-gris">
                Volver al inicio
            </a>
        </div>

    </div>

</form>
