@page
@model asp_front.Pages.Ventanas.DetallesVentasMotosModel

@{
    ViewData["Title"] = "Detalles de ventas de motos";
    var total = Model.Lista?.Count ?? 0;
}

<style>
    .detalles-motos-container {
        padding: 25px;
        color: #263445;
    }

    .detalles-motos-header {
        background: linear-gradient(135deg,#172536,#294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 22px;
    }

    .detalles-motos-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 3px 12px #00000012;
        height: 100%;
    }

    .detalles-motos-search, .detalles-motos-form {
        background: white;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 3px 12px #00000012;
        margin-bottom: 22px;
    }

    .detalles-motos-table-container {
        background: white;
        padding: 18px;
        border-radius: 12px;
        overflow-x: auto;
        box-shadow: 0 3px 12px #00000012;
    }

    .detalles-motos-table {
        width: 100%;
        border-collapse: collapse;
    }

        .detalles-motos-table th {
            background: #f3f6fa;
            padding: 13px;
            text-align: left;
        }

        .detalles-motos-table td {
            padding: 12px;
            border-bottom: 1px solid #e5e9ef;
        }

    .detalles-motos-form label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .detalles-motos-form input,
    .detalles-motos-form select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ced6df;
        border-radius: 7px;
    }

    .btn-detalles-motos {
        border: 0;
        border-radius: 7px;
        padding: 9px 15px;
        color: white;
        cursor: pointer;
        margin: 2px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

        .btn-azul:hover {
            background: #1c344d;
            color: white;
        }

    .btn-verde {
        background: #16834a;
        color: white;
    }

        .btn-verde:hover {
            background: #116638;
            color: white;
        }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

        .btn-rojo:hover {
            background: #fbdada;
            color: #a52a20;
        }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .detalles-motos-popup {
        background: #fff4f4;
        border: 1px solid #f2baba;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
    }
</style>

<form method="post">
    <div class="detalles-motos-container">

        <div class="detalles-motos-header">
            <h1>🏍️ Detalles de ventas de motos</h1>
            <p>Administración de las motocicletas incluidas en cada venta</p>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="detalles-motos-card">
                    <p>Total de detalles registrados</p>
                    <h2>@total</h2>
                </div>
            </div>
            <div class="col-md-6">
                <div class="detalles-motos-card">
                    <p>Gestión de motocicletas</p>
                    <h2 style="color:#16834a">Ventas</h2>
                </div>
            </div>
        </div>

        <div class="detalles-motos-search">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">ID de venta</label>
                    <input asp-for="Filtro!.Venta" type="number" class="form-control" placeholder="Buscar por venta..." />
                </div>
                <div class="col-md-2">
                    <input type="submit" value="Consultar" asp-page-handler="BtConsultar" class="btn-detalles-motos btn-azul w-100" />
                </div>
                <div class="col-md-2">
                    <input type="submit" value="+ Nuevo detalle" asp-page-handler="BtNuevo" class="btn-detalles-motos btn-verde w-100" />
                </div>
            </div>
        </div>

        @if (Model.Formulario && Model.Actual != null)
        {
            <div class="detalles-motos-form">
                <h3>@(Model.Actual.ID == 0 ? "Nuevo detalle de venta" : "Editar detalle de venta")</h3>

                <input type="hidden" asp-for="Actual!.ID" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label>Precio unitario</label>
                        <input asp-for="Actual!.Precio_Unitario" type="number" step="0.01" />
                    </div>

                    <div class="col-md-6">
                        <label>Descuento</label>
                        <input asp-for="Actual!.Descuento" type="number" step="0.01" />
                    </div>

                    <div class="col-md-6">
                        <label>Subtotal</label>
                        <input asp-for="Actual!.Subtotal" type="number" step="0.01" />
                    </div>

                    <div class="col-md-6">
                        <label>Moto</label>
                        <select asp-for="Actual!.Moto" class="form-select">
                            <option value="0">Seleccione una moto</option>
                            @if (Model.ListaMotos != null)
                            {
                                foreach (var moto in Model.ListaMotos)
                                {
                                    <option value="@moto.ID">
                                        @moto.VIN - @moto.Numero_Motor
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label>Venta</label>
                        <select asp-for="Actual!.Venta" class="form-select">
                            <option value="0">Seleccione una venta</option>
                            @if (Model.ListaVentas != null)
                            {
                                foreach (var venta in Model.ListaVentas)
                                {
                                    <option value="@venta.ID">
                                        Venta #@venta.ID - @venta.Fecha_Venta.ToString("dd/MM/yyyy")
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-4">
                    <input type="submit" value="Guardar" asp-page-handler="BtGuardar" class="btn-detalles-motos btn-verde" />
                    <input type="submit" value="Cancelar" asp-page-handler="BtConsultar" class="btn-detalles-motos btn-gris" />
                </div>
            </div>
        }

        @if (Model.Borrar && Model.Actual != null)
        {
            <div class="detalles-motos-popup">
                <h4>¿Deseas eliminar este detalle de venta?</h4>
                <p>Registro: <strong>@Model.Actual.ID</strong></p>

                <input type="hidden" asp-for="Actual!.ID" />

                <input type="submit" value="Sí, eliminar" asp-page-handler="BtBorrar" class="btn-detalles-motos btn-rojo" />
                <input type="submit" value="Cancelar" asp-page-handler="BtConsultar" class="btn-detalles-motos btn-gris" />
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="detalles-motos-table-container">
                <h3>Listado de detalles de ventas de motos</h3>

                <table class="detalles-motos-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Precio unitario</th>
                            <th>Descuento</th>
                            <th>Subtotal</th>
                            <th>Moto</th>
                            <th>Venta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Lista)
                        {
                            <tr>
                                <td>@item.ID</td>
                                <td>@item.Precio_Unitario</td>
                                <td>@item.Descuento</td>
                                <td>@item.Subtotal</td>
                                <td>@(Model.ListaMotos.FirstOrDefault(x => x.ID == item.Moto)?.VIN ?? "Sin moto")</td>
                                <td>@(Model.ListaVentas.FirstOrDefault(x => x.ID == item.Venta)?.Fecha_Venta.ToString("dd/MM/yyyy") is string fecha ? $"Venta #{item.Venta} - {fecha}" : "Sin venta")</td>
                                <td>
                                    <input type="submit" value="Editar" asp-page-handler="BtEditar" asp-route-data="@item.ID" class="btn-detalles-motos btn-azul" />
                                    <input type="submit" value="Eliminar" asp-page-handler="BtPregBorrar" asp-route-data="@item.ID" class="btn-detalles-motos btn-rojo" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-4">
            <a asp-page="/Index" class="btn-detalles-motos btn-gris">Volver al inicio</a>
        </div>

    </div>
</form>
