
@page
@model asp_front.Pages.Ventanas.PersonasModel

@{
    ViewData["Title"] = "Personas";

    var totalPersonas = Model.Lista?.Count ?? 0;
    var conTelefono = Model.Lista?.Count(x => !string.IsNullOrEmpty(x.Telefono)) ?? 0;
    var mayores = Model.Lista?.Count(x =>
        x.Fecha_Nacimiento != default &&
        x.Fecha_Nacimiento <= DateTime.Today.AddYears(-18)) ?? 0;
}

<style>
    .personas-container {
        padding: 25px;
        color: #263445;
    }

    .personas-header {
        background: linear-gradient(135deg, #172536, #294766);
        color: white;
        padding: 35px;
        border-radius: 14px;
        margin-bottom: 25px;
    }

    .personas-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .personas-header p {
        color: #d4deea;
        margin: 0;
    }

    .personas-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        height: 100%;
    }

    .personas-card h2 {
        font-size: 30px;
        font-weight: 700;
        margin: 8px 0;
    }

    .personas-card p {
        color: #758397;
        margin: 0;
    }

    .personas-search,
    .personas-form,
    .personas-table-container {
        background: white;
        padding: 22px;
        border-radius: 12px;
        border: 1px solid #e5eaf0;
        margin: 25px 0;
    }

    .personas-search input,
    .personas-form input {
        border: 1px solid #dce2e9;
        border-radius: 7px;
        padding: 10px;
        width: 100%;
        margin-bottom: 12px;
    }

    .personas-form label {
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
    }

    .personas-table-container {
        overflow-x: auto;
    }

    .personas-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 800px;
    }

    .personas-table th {
        background: #f3f6fa;
        color: #526174;
        padding: 15px;
        text-align: left;
        font-size: 13px;
    }

    .personas-table td {
        padding: 15px;
        border-bottom: 1px solid #edf0f4;
        vertical-align: middle;
    }

    .personas-table tr:hover {
        background: #f8fafc;
    }

    .btn-personas {
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        margin: 3px;
    }

    .btn-azul {
        background: #294766;
        color: white;
    }

    .btn-azul:hover {
        background: #1c344d;
        color: white;
    }

    .btn-verde {
        background: #16834a;
        color: white;
    }

    .btn-verde:hover {
        background: #116638;
        color: white;
    }

    .btn-rojo {
        background: #fff0f0;
        color: #c0392b;
    }

    .btn-rojo:hover {
        background: #fbdada;
        color: #a52a20;
    }

    .btn-gris {
        background: #edf1f5;
        color: #46566a;
    }

    .personas-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 15px;
    }

    .personas-popup-inner {
        background: white;
        border-radius: 14px;
        padding: 30px;
        max-width: 450px;
        width: 100%;
        text-align: center;
    }
</style>

<form method="post">

    <div class="personas-container">

        <div class="personas-header">
            <h1>👥 Personas</h1>
            <p>Administración de información personal y datos de contacto</p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="personas-card">
                    <p>Total de personas</p>
                    <h2>@totalPersonas</h2>
                    <small>Personas registradas</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="personas-card">
                    <p>Con teléfono</p>
                    <h2 style="color:#16834a">@conTelefono</h2>
                    <small>Personas con contacto registrado</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="personas-card">
                    <p>Mayores de edad</p>
                    <h2 style="color:#294766">@mayores</h2>
                    <small>Según fecha de nacimiento</small>
                </div>
            </div>

        </div>

        <div class="personas-search">

            <h5>Buscar personas</h5>

            <div class="row mt-3">

                <div class="col-md-4">
                    <input placeholder="Buscar por nombre"
                           asp-for="@Model.Filtro!.Nombre" />
                </div>

                <div class="col-md-4">
                    <input placeholder="Buscar por cédula"
                           asp-for="@Model.Filtro!.Cedula" />
                </div>

                <div class="col-md-4">
                    <input type="submit"
                           value="Consultar"
                           class="btn-personas btn-azul w-100"
                           asp-page-handler="BtConsultar" />
                </div>

            </div>

            <input type="submit"
                   value="+ Nueva persona"
                   class="btn-personas btn-verde"
                   asp-page-handler="BtNuevo" />

        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.ID" />
        }

        @if (Model.Formulario)
        {
            <div class="personas-form">

                <h4>Información personal</h4>
                <p class="text-muted">
                    Completa los datos para registrar o actualizar una persona.
                </p>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <label>Nombre completo</label>
                        <input asp-for="@Model.Actual!.Nombre"
                               placeholder="Nombre completo" />
                    </div>

                    <div class="col-md-6">
                        <label>Cédula</label>
                        <input asp-for="@Model.Actual!.Cedula"
                               placeholder="Número de identificación" />
                    </div>

                    <div class="col-md-6">
                        <label>Fecha de nacimiento</label>
                        <input asp-for="@Model.Actual!.Fecha_Nacimiento"
                               type="date" />
                    </div>

                    <div class="col-md-6">
                        <label>Teléfono</label>
                        <input asp-for="@Model.Actual!.Telefono"
                               placeholder="Número de contacto" />
                    </div>

                </div>

                <div class="mt-3">

                    <input type="submit"
                           value="Guardar persona"
                           class="btn-personas btn-verde"
                           asp-page-handler="BtGuardar" />

                    <input type="submit"
                           value="Cancelar"
                           class="btn-personas btn-gris"
                           asp-page-handler="BtConsultar" />

                </div>

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="personas-popup">

                <div class="personas-popup-inner">

                    <h3>⚠️ Confirmar eliminación</h3>

                    <p class="mt-3">
                        ¿Estás seguro de que deseas eliminar esta persona?
                    </p>

                    <p>
                        <strong>@Model.Actual!.Nombre</strong>
                        <br />
                        Cédula: @Model.Actual.Cedula
                    </p>

                    <input type="submit"
                           value="Cancelar"
                           class="btn-personas btn-gris"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Sí, eliminar"
                           class="btn-personas btn-rojo"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="personas-table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4>Listado de personas</h4>
                    <span class="text-muted">@totalPersonas registros</span>
                </div>

                <table class="personas-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Cédula</th>
                            <th>Fecha de nacimiento</th>
                            <th>Teléfono</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista != null && Model.Lista.Count > 0)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td>@elemento.ID</td>
                                    <td><strong>@elemento.Nombre</strong></td>
                                    <td>@elemento.Cedula</td>
                                    <td>
                                        @(elemento.Fecha_Nacimiento == default
                                            ? "Sin fecha"
                                            : elemento.Fecha_Nacimiento.ToString("dd/MM/yyyy"))
                                    </td>
                                    <td>@elemento.Telefono</td>

                                    <td>
                                        <input type="submit"
                                               value="Editar"
                                               class="btn-personas btn-azul"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.ID" />

                                        <input type="submit"
                                               value="Eliminar"
                                               class="btn-personas btn-rojo"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.ID" />
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No hay personas registradas.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <div class="text-center mt-4">
            <a asp-page="/Index" class="btn-personas btn-gris">
                Volver al inicio
            </a>
        </div>

    </div>

</form>
