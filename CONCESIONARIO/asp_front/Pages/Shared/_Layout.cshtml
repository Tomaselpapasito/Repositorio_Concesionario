@{
    var permisosTexto = Context.Session.GetString("Permisos") ?? "";

    var permisos = permisosTexto
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p.Trim())
        .ToHashSet();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Concesionario</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .navbar-concesionario {
            background: linear-gradient(135deg, #172536, #294766);
            padding: 12px 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,.18);
        }

        .navbar-concesionario .navbar-brand {
            color: white;
            font-weight: 700;
            font-size: 21px;
            margin-right: 25px;
            white-space: nowrap;
        }

        .navbar-concesionario .nav-link {
            color: #eaf0f6;
            font-weight: 500;
            padding: 10px 16px;
            border-radius: 8px;
        }

        .navbar-concesionario .nav-link:hover,
        .navbar-concesionario .nav-link:focus {
            color: white;
            background: rgba(255,255,255,.13);
        }

        .navbar-concesionario .dropdown-menu {
            border: none;
            border-radius: 10px;
            padding: 8px;
            min-width: 210px;
            box-shadow: 0 6px 18px rgba(0,0,0,.18);
        }

        .navbar-concesionario .dropdown-item {
            padding: 9px 12px;
            border-radius: 6px;
            color: #26384b;
        }

        .navbar-concesionario .dropdown-item:hover {
            background: #e9f0f7;
            color: #172536;
        }

        .navbar-concesionario .navbar-toggler {
            border-color: rgba(255,255,255,.5);
        }

        .navbar-concesionario .navbar-toggler-icon {
            filter: invert(1);
        }

        .contenido-principal {
            min-height: calc(100vh - 130px);
        }

        footer {
            color: #718096;
            text-align: center;
            padding: 18px;
        }

        @@media (max-width: 991px) {
            .navbar-concesionario .navbar-nav {
                flex-direction: column;
                align-items: stretch;
                padding-top: 12px;
            }

            .navbar-concesionario .nav-link {
                padding: 10px 12px;
            }
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-concesionario">
            <div class="container-fluid">

                <a class="navbar-brand" asp-page="/Index">
                    CONCESIONARIO
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">


                    <ul class="navbar-nav me-auto">

                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio</a>
                        </li>

                        <!-- INVENTARIO -->
                        @if (permisos.Overlaps(new[] { "Motos", "ModelosMotos", "Productos", "Repuestos", "Accesorios", "Inventarios" }))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                    Inventario
                                </a>

                                <ul class="dropdown-menu">
                                    @if (permisos.Contains("Motos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Motos">Motos</a></li>
                                    }
                                    @if (permisos.Contains("ModelosMotos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/ModelosMotos">Modelos de motos</a></li>
                                    }
                                    @if (permisos.Contains("Productos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Productos">Productos</a></li>
                                    }
                                    @if (permisos.Contains("Repuestos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Repuestos">Repuestos</a></li>
                                    }
                                    @if (permisos.Contains("Accesorios"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Accesorios">Accesorios</a></li>
                                    }
                                    @if (permisos.Contains("Inventarios"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Inventarios">Inventarios</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        <!-- ADMINISTRACIÓN -->
                        @if (permisos.Overlaps(new[] { "Clientes", "Empleados", "Personas", "Proveedores", "Cargos", "Usuarios", "Roles" }))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                    Administración
                                </a>

                                <ul class="dropdown-menu">
                                    @if (permisos.Contains("Clientes"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Clientes">Clientes</a></li>
                                    }
                                    @if (permisos.Contains("Empleados"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Empleados">Empleados</a></li>
                                    }
                                    @if (permisos.Contains("Personas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Personas">Personas</a></li>
                                    }
                                    @if (permisos.Contains("Proveedores"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Proveedores">Proveedores</a></li>
                                    }
                                    @if (permisos.Contains("Cargos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Cargos">Cargos</a></li>
                                    }
                                    @if (permisos.Contains("Usuarios"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Usuarios">Usuarios</a></li>
                                    }
                                    @if (permisos.Contains("Roles"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Roles">Roles</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        <!-- COMPRAS -->
                        @if (permisos.Overlaps(new[] { "Compras", "DetallesCompras" }))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                    Compras
                                </a>

                                <ul class="dropdown-menu">
                                    @if (permisos.Contains("Compras"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Compras">Compras</a></li>
                                    }
                                    @if (permisos.Contains("DetallesCompras"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/DetallesCompras">Detalles de compras</a></li>
                                    }
                                </ul>
                            </li>
                        }


                        <!-- VENTAS -->
                        @if (permisos.Overlaps(new[] { "Ventas", "DetallesVentasMotos", "DetallesVentasProductos", "Facturas" }))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                    Ventas
                                </a>

                                <ul class="dropdown-menu">
                                    @if (permisos.Contains("Ventas"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-page="/Ventanas/Ventas">Ventas</a>
                                        </li>
                                    }

                                    @if (permisos.Contains("DetallesVentasMotos"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-page="/Ventanas/DetallesVentasMotos">
                                                Detalles de ventas de motos
                                            </a>
                                        </li>
                                    }

                                    @if (permisos.Contains("DetallesVentasProductos"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-page="/Ventanas/DetallesVentasProductos">
                                                Detalles de ventas de productos
                                            </a>
                                        </li>
                                    }

                                    @if (permisos.Contains("Facturas"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-page="/Ventanas/Facturas">
                                                Generar facturas PDF
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }


                        <!-- FINANZAS -->
                        @if (permisos.Overlaps(new[] { "Financiamientos", "Cuotas", "Pagos", "MetodosPagos" }))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                    Finanzas
                                </a>

                                <ul class="dropdown-menu">
                                    @if (permisos.Contains("Financiamientos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Financiamientos">Financiamientos</a></li>
                                    }
                                    @if (permisos.Contains("Cuotas"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Cuotas">Cuotas</a></li>
                                    }
                                    @if (permisos.Contains("Pagos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/Pagos">Pagos</a></li>
                                    }
                                    @if (permisos.Contains("MetodosPagos"))
                                    {
                                        <li><a class="dropdown-item" asp-page="/Ventanas/MetodosPagos">Métodos de pago</a></li>
                                    }
                                </ul>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid contenido-principal">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            &copy; 2026 - Sistema de gestión del concesionario
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
