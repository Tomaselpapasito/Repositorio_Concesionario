
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Concesionario</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/asp_front.styles.css" asp-append-version="true" />

    <style>
        .navbar-concesionario {
            background: linear-gradient(135deg, #172536, #294766);
            padding: 12px 0;
        }

        .navbar-concesionario .navbar-brand,
        .navbar-concesionario .nav-link {
            color: white !important;
            font-weight: 500;
        }

        .navbar-concesionario .navbar-brand {
            font-size: 21px;
            font-weight: 700;
        }

        .navbar-concesionario .nav-link {
            padding: 10px 15px !important;
            border-radius: 7px;
        }

        .navbar-concesionario .nav-link:hover {
            background: rgba(255,255,255,0.13);
        }

        .navbar-concesionario .dropdown-menu {
            border: none;
            border-radius: 10px;
            padding: 8px;
            box-shadow: 0 5px 18px rgba(0,0,0,0.15);
        }

        .navbar-concesionario .dropdown-item {
            padding: 9px 13px;
            border-radius: 6px;
        }

        .navbar-concesionario .dropdown-item:hover {
            background: #eaf1f8;
            color: #172536;
        }

        .navbar-concesionario .navbar-toggler {
            border-color: rgba(255,255,255,0.5);
        }

        .navbar-concesionario .navbar-toggler-icon {
            filter: brightness(0) invert(1);
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-concesionario shadow-sm mb-4">
            <div class="container">

                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    CONCESIONARIO
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">

                    <ul class="navbar-nav mxauto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Index">
                                Inicio
                            </a>
                        </li>

                        <!-- ADMINISTRACIÓN -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Administración
                            </a>

                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-page="/Ventanas/Clientes">
                                        Clientes
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- INVENTARIO -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Inventario
                            </a>

                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-page="/Ventanas/Motos">
                                        Motos
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- VENTAS -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Ventas
                            </a>

                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-page="/Ventanas/Ventas">
                                        Ventas
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Concesionario
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
