
@page
@model asp_front.Pages.IndexModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

@if (!Model.EstaLogueado)
{
    <div class="container mt-5" style="max-width: 450px;">
        <div class="card shadow p-4">
            <h2 class="text-center mb-4">Iniciar sesión</h2>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Usuario:</label>
                    <input asp-for="Email" class="form-control"
                           placeholder="Ingrese su usuario" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña:</label>
                    <input asp-for="Contraseña" type="password"
                           class="form-control"
                           placeholder="Ingrese su contraseña" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" asp-page-handler="BtClean"
                            class="btn btn-secondary w-50">
                        Limpiar
                    </button>

                    <button type="submit" asp-page-handler="BtEnter"
                            class="btn btn-primary w-50">
                        Entrar
                    </button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="container text-center mt-5">
        <h1>¡Bienvenido!</h1>
        <p>Has iniciado sesión correctamente.</p>

        <form method="post">
            <button type="submit" asp-page-handler="BtClose"
                    class="btn btn-danger">
                Cerrar sesión
            </button>
        </form>
    </div>
}
